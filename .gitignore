credentials.json
secrets.json

# Generated datasets, outputs, caches, and training runs
datasets/
outputs/
cache/
caches/
runs/
phase0/artifacts/
phase0/logs/
phase1/artifacts/
phase*/artifacts/
phase*/logs/
**/hf-cache/
**/huggingface/
**/.cache/
**/TTS_CACHE/
